<Window x:Class="ChessLAN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChessLAN · Cờ vua qua LAN" Height="800" Width="1280" MinHeight="700" MinWidth="1000" Background="#16181C" Foreground="#F1F0E8" FontFamily="Segoe UI">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><TextBlock Text="♞  CHESSLAN" FontSize="25" FontWeight="Bold" Foreground="#81B64C"/><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="● Sẵn sàng" Foreground="#AAB0B8" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#22252B" CornerRadius="18" Padding="18" Margin="0,0,18,0"><UniformGrid x:Name="Board" Rows="8" Columns="8"/></Border>
   <StackPanel Grid.Column="1" Background="#22252B" Margin="0" >
    <TextBlock Text="CHƠI CỜ" FontSize="29" FontWeight="Bold" Margin="24,24,20,10"/>
    <TextBlock Text="Biệt danh" Margin="24,16,24,5"/><TextBox x:Name="NicknameBox" Text="Người chơi" Margin="24,0,24,0" Padding="10"/>
    <TextBlock Text="Địa chỉ IPv4 máy chủ" Margin="24,12,24,5"/><TextBox x:Name="HostBox" Text="127.0.0.1" Margin="24,0,24,0" Padding="10"/>
    <TextBlock Text="Cổng TCP" Margin="24,12,24,5"/><TextBox x:Name="PortBox" Text="5000" Margin="24,0,24,0" Padding="10"/>
    <Button Content="TẠO PHÒNG · CẦM TRẮNG" Click="Host_Click" Margin="24,22,24,8" Padding="12" Background="#81B64C" Foreground="#16181C" FontWeight="Bold"/>
    <Button Content="THAM GIA · CẦM ĐEN" Click="Join_Click" Margin="24,0,24,8" Padding="12" Background="#343941" Foreground="White"/>
    <TextBlock Text="Lịch sử nước đi" FontSize="18" FontWeight="SemiBold" Margin="24,24,24,8"/><TextBox x:Name="HistoryBox" IsReadOnly="True" Height="130" Margin="24,0,24,24" Background="#1B1E23" Foreground="#E8E6DA" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid><TextBlock Grid.Row="2" Text="ChessLAN  ·  Kết nối trực tiếp TCP trong mạng LAN" Foreground="#858B94"/>
 </Grid>
</Window>
