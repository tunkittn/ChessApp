<Window x:Class="ChessLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChessLAN · Cờ vua qua LAN" Height="800" Width="1280"
        MinHeight="700" MinWidth="1000" Background="#16181C"
        Foreground="#F1F0E8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#191C21"/><Setter Property="Foreground" Value="#F2F2ED"/><Setter Property="BorderBrush" Value="#3A3F47"/><Setter Property="CaretBrush" Value="#81B64C"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#81B64C"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/><Setter TargetName="ButtonBorder" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.015" ScaleY="1.015"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Board squares deliberately stay square; the rounded button style is for the lobby UI only. -->
  <Style x:Key="SquareButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderThickness="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28,22,28,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="♞" FontSize="30" Foreground="#81B64C"/><TextBlock Text="CHESSLAN" FontSize="25" FontWeight="Bold" Foreground="#81B64C" Margin="10,0,0,0"/><TextBlock Text="  ·  CỜ VUA QUA LAN" FontSize="11" FontWeight="SemiBold" Foreground="#838A95" VerticalAlignment="Center" Margin="8,5,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#22252B" CornerRadius="16" Padding="13,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#858B94" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Sẵn sàng tạo hoặc tham gia phòng" Foreground="#C3C7CE" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
   <Border Background="#22252B" CornerRadius="20" Padding="18" Margin="0,0,20,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="TopClockBorder" Grid.Row="0" Background="#191C21" CornerRadius="10" Padding="13,7" HorizontalAlignment="Right" Margin="0,0,2,8"><TextBlock x:Name="TopClockText" Text="ĐEN  05:00" FontSize="15" FontWeight="Bold" Foreground="#F2E7C9"/></Border>
    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid Width="640" Height="640" Background="#181B20">
      <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
      <UniformGrid x:Name="Board" Grid.Row="1" Grid.Column="1" Rows="8" Columns="8"/>
      <UniformGrid x:Name="RankCoordinates" Grid.Row="1" Grid.Column="0" Rows="8" IsHitTestVisible="False"><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/></UniformGrid>
      <UniformGrid x:Name="FileCoordinates" Grid.Row="2" Grid.Column="1" Columns="8" IsHitTestVisible="False"><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/><TextBlock/></UniformGrid>
     </Grid>
    </Viewbox>
    <Border x:Name="BottomClockBorder" Grid.Row="2" Background="#191C21" CornerRadius="10" Padding="13,7" HorizontalAlignment="Right" Margin="0,8,2,0"><TextBlock x:Name="BottomClockText" Text="TRẮNG  05:00" FontSize="15" FontWeight="Bold" Foreground="#F2E7C9"/></Border>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="#22252B" CornerRadius="20" Padding="24">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="SẢNH CỜ" FontSize="11" FontWeight="Bold" Foreground="#81B64C"/><TextBlock Text="Tạo phòng hoặc tham gia" FontSize="24" FontWeight="Bold" Margin="0,4,0,4"/><TextBlock Text="Kết nối trực tiếp giữa hai người chơi." Foreground="#A5ABB4" FontSize="13"/></StackPanel>
     <StackPanel Grid.Row="1" Margin="0,20,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BIỆT DANH" FontSize="10" FontWeight="Bold" Foreground="#969DA7" Margin="0,0,0,7"/><TextBox x:Name="NicknameBox" Text="Người chơi"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="THỜI GIAN" FontSize="10" FontWeight="Bold" Foreground="#969DA7" Margin="0,0,0,7"/><UniformGrid Rows="1" Columns="3"><Button x:Name="Time10Button" Content="10 phút" Tag="600" Click="TimeControl_Click" Padding="4,9" Margin="0,0,3,0" Background="#343941" Foreground="#F1F0E8"/><Button x:Name="Time5Button" Content="5 phút" Tag="300" Click="TimeControl_Click" Padding="4,9" Margin="1,0,1,0" Background="#81B64C" Foreground="#151811"/><Button x:Name="Time1Button" Content="1 phút" Tag="60" Click="TimeControl_Click" Padding="4,9" Margin="3,0,0,0" Background="#343941" Foreground="#F1F0E8"/></UniformGrid></StackPanel></Grid>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ĐỊA CHỈ IP MÁY CHỦ" FontSize="10" FontWeight="Bold" Foreground="#969DA7" Margin="0,0,0,7"/><TextBox x:Name="HostBox" Text="127.0.0.1"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="CỔNG TCP" FontSize="10" FontWeight="Bold" Foreground="#969DA7" Margin="0,0,0,7"/><TextBox x:Name="PortBox" Text="5000"/></StackPanel></Grid>
      <Button x:Name="HostButton" Content="TẠO PHÒNG  ·  CẦM QUÂN TRẮNG" Click="Host_Click" Margin="0,16,0,0" Background="#81B64C" Foreground="#151811"/>
      <Button x:Name="JoinButton" Content="THAM GIA  ·  CẦM QUÂN ĐEN" Click="Join_Click" Margin="0,9,0,0" Background="#343941" Foreground="#F1F0E8"/>
      <Button x:Name="ResignButton" Content="ĐẦU HÀNG" Click="Resign_Click" IsEnabled="False" Margin="0,9,0,0" Background="#473336" Foreground="#F1F0E8"/>
      <Button x:Name="CancelButton" Content="HỦY CHỜ" Click="Cancel_Click" Visibility="Collapsed" Margin="0,9,0,0" Background="#473336" Foreground="#F1F0E8"/>
      <Border Background="#191C21" CornerRadius="10" Padding="12" Margin="0,14,0,0"><TextBlock x:Name="RoomHintText" Text="Tạo phòng sẽ chờ một đối thủ kết nối. Thử nghiệm trên cùng máy: mở ứng dụng lần hai, nhập 127.0.0.1 và cùng cổng." TextWrapping="Wrap" FontSize="11" Foreground="#9DA4AE" LineHeight="17"/></Border>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="0,22,0,0"><Grid><TextBlock Text="NƯỚC ĐI" FontSize="11" FontWeight="Bold" Foreground="#969DA7"/><TextBlock x:Name="GameResultLabel" Text="TRẬN ĐẤU" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="#81B64C"/></Grid><Border Background="#191C21" CornerRadius="12" Margin="0,9,0,0" Padding="12" Height="170" VerticalAlignment="Top"><ScrollViewer Height="144" VerticalScrollBarVisibility="Auto"><TextBox x:Name="HistoryBox" IsReadOnly="True" MinHeight="140" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" Foreground="#D5D8D2"/></ScrollViewer></Border></StackPanel>
     <TextBlock Grid.Row="3" Text="TCP  ·  JSON theo dòng  ·  FEN đồng bộ" FontSize="10" Foreground="#747C86" Margin="0,14,0,0"/>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,15,0,0"><TextBlock Text="ChessLAN" FontSize="11" Foreground="#7E858E"/><TextBlock Text="Kết nối trực tiếp · Mạng LAN" HorizontalAlignment="Right" FontSize="11" Foreground="#7E858E"/></Grid>
 </Grid>
</Window>
